[Unit]
Description=Meme Foundry web app
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=hendo420
WorkingDirectory=/home/hendo420/memeGame
EnvironmentFile=/home/hendo420/memeGame/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/bash -lc 'corepack pnpm --dir apps/web exec next start -H 127.0.0.1 -p 3000'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
