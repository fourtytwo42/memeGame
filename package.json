{
  "name": "meme-foundry",
  "version": "0.1.0",
  "private": true,
  "description": "Meme Foundry production web game monorepo.",
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @meme-foundry/web dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:workers": "tsx scripts/simulate-token-tick.ts",
    "test:browser-audit": "tsx scripts/stage15-browser-audit.ts",
    "test:a11y": "tsx scripts/stage15-a11y.ts",
    "test:stress": "tsx scripts/stage15-stress.ts",
    "test:scale": "tsx scripts/stage8-scale-check.ts",
    "test:release": "pnpm verify && pnpm test:browser-audit && pnpm test:a11y && pnpm test:stress && pnpm test:scale && pnpm test:realtime-load && pnpm test:support-burst && pnpm test:crew-scale && pnpm test:ai-smoke && pnpm test:ai-text-burst && pnpm test:image-burst && pnpm test:backup-restore",
    "prisma:validate": "node scripts/prisma-validate.mjs",
    "audit": "pnpm audit --audit-level high",
    "build": "pnpm -r --if-present build",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm prisma:validate && pnpm build",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:test:reset": "node scripts/reset-test-db.mjs",
    "db:seed:scale": "tsx scripts/seed-scale.ts",
    "simulate:tick": "tsx scripts/simulate-token-tick.ts",
    "world:refresh": "tsx scripts/refresh-world-state.ts",
    "realtime:dev": "pnpm --filter @meme-foundry/realtime-app dev",
    "test:realtime-load": "tsx scripts/realtime-load.ts",
    "test:support-burst": "tsx scripts/support-burst.ts",
    "test:crew-scale": "tsx scripts/stage11-crew-scale-check.ts",
    "test:ai-smoke": "tsx scripts/ai-local-smoke.ts",
    "test:ai-text-burst": "tsx scripts/ai-text-burst.ts",
    "test:image-burst": "tsx scripts/image-job-burst.ts",
    "test:backup-restore": "tsx scripts/backup-restore-smoke.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@next/eslint-plugin-next": "^16.2.6",
    "@playwright/test": "^1.60.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.0.0",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^10.1.0",
    "ioredis": "^5.10.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.7.0",
    "prisma": "^7.8.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0"
  }
}
